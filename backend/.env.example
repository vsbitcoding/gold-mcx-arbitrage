# Angel One SmartAPI (live feed, NSE commodity poll, candles) - key locked to the server IP
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# App
APP_SECRET_KEY=change-me-to-random-32-char-string
TRADING_MODE=paper

# Admin Login (set via create_user script, do NOT put plain password here)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Database (SQLite for simplicity)
DATABASE_URL=sqlite:///./arbi.db

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://arbitrage.bitcoding.ai,http://localhost:5173

# Instrument Tokens (exchange tokens - fill in actual values)
PETAL_SECURITY_ID=
GUINEA_SECURITY_ID=
TEN_SECURITY_ID=
MINI_SECURITY_ID=

# Exchange segment for MCX commodity futures
EXCHANGE_SEGMENT=MCX_COMM

# MCXCCL daily bullion warehouse-stock scrape (Bullion Stock tab). Defaults are
# sensible; override only if needed. Needs `playwright install chromium`.
# BULLION_STOCK_ENABLED=true
# MCXCCL_FETCH_HOUR_IST=18
# MCXCCL_FETCH_MINUTE_IST=0
FINNHUB_API_KEY=
